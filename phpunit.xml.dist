<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         testdox="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <!--
        Red tests are kept in two groups and excluded here, so that `composer test` is green:
        known-defect     - fails because of a defect in the registry of PLAN-port-php82.md (ID in the docblock)
        pending-stage-1  - cannot run until Stage 1 replaces Universal\Http\HttpRequest and PHPSGI\App
        `composer test:red` runs only these groups, `composer test:all` runs everything.
    -->
    <groups>
        <exclude>
            <group>known-defect</group>
            <group>pending-stage-1</group>
        </exclude>
    </groups>

    <!--
        phpunit.baseline.xml lists exactly three PHP 8.4 compile-time deprecations, registry IDs P1
        (Mux.php:345, 425) and P2 (RESTfulMuxBuilder.php:30). They fire when the class is first
        loaded, so they would be attributed to whichever test loads it first. Matching is by file,
        line, line hash and message: any other deprecation still fails the run. The baseline is
        deleted in Stage 5 together with the fix of P1 and P2.
    -->
    <source baseline="phpunit.baseline.xml">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
